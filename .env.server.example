# Copy to .env.server for local Edge Functions. Do not expose these to the app.
# The Supabase CLI supplies SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY to local functions automatically.
DAILY_MAINTENANCE_SECRET=
REVENUECAT_WEBHOOK_AUTH=
EXPO_ACCESS_TOKEN=
NOTIFICATION_DELIVERY_PROVIDER=expo
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
TURNSTILE_SECRET_KEY=
APPLE_NATIVE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=


# Optional Menta Check: provider secret stays server-side. Provider calls may cost money.
OPENROUTER_API_KEY=
MENTA_CHECK_JEV_MODEL=typesafe/jev-1.13
MENTA_CHECK_VISION_MODEL=google/gemini-3.1-flash-lite
MENTA_CHECK_SECOND_LOOK_MODEL=google/gemini-3.8-flash
