{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "paths": {
      "@/*": ["./*"]
    },
    "typeRoots": ["./types"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "tools",
    "domain/menta.quest/lovable-overlay",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__",
    "supabase/functions"
  ]
}
