# Copy to .env.local. Use your own local or hosted Supabase project.
# Public configuration only. Keep server secrets in .env.server instead.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your own Expo project ID, for device push notifications.
EXPO_PUBLIC_PROJECT_ID=

# RevenueCat public SDK keys (iOS appl_..., Android goog_...). Never use a secret key.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
EXPO_PUBLIC_APPROVED_CREDIT_SKUS=

# OAuth remains off until you register credentials for your own bundle IDs.
EXPO_PUBLIC_DISABLE_GOOGLE_LOGIN=true
EXPO_PUBLIC_DISABLE_APPLE_LOGIN=true
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_APPLE_CLIENT_ID=

# Optional integrations are inactive until explicitly configured.
EXPO_PUBLIC_GROUP_NOTIFICATIONS_ENABLED=false
EXPO_PUBLIC_RETENTION_NOTIFICATIONS_ENABLED=false
EXPO_PUBLIC_RETENTION_NOTIFICATION_PROVIDER=none
EXPO_PUBLIC_ONESIGNAL_APP_ID=
EXPO_PUBLIC_ONESIGNAL_USER_DATA_ENABLED=false
EXPO_PUBLIC_ADS_ENABLED=false
EXPO_PUBLIC_REVENUECAT_AD_REWARDS_VERIFIED=false
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_REPLAY_ENABLED=false
EXPO_PUBLIC_AMPLITUDE_API_KEY=
EXPO_PUBLIC_AMPLITUDE_REPLAY_ENABLED=false
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_REPLAY_ENABLED=false
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
EXPO_PUBLIC_SAFE_MODE=false
EXPO_PUBLIC_E2E_MODE=0
EXPO_PUBLIC_DOGFOOD_DISABLE_ADS=0

